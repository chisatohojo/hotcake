{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HotCake: Verify Mega 2560",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/verify_environment.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "HotCake: Setup pinned environment",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/setup_windows.ps1",
        "-InstallExtensions"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc"
    }
  ]
}
