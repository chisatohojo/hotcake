# Arduino compilation products
/build/
**/build/
*.hex
*.elf
*.eep
*.o
*.a
*.d
*.map
*.bin
compile_commands.json

# Share portable editor settings and tasks; ignore other local editor files
/.vscode/*
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/settings.json
*.code-workspace

# Local tools, profiles, and scratch files
/.tools/
/.arduino-local/
*.log
*.tmp
*.bak
*~

# Original unnamed local reference images (kept on the current PC)
/image.jpg
/rn_image_picker_lib_temp_*.webp

# OS files
Thumbs.db
Desktop.ini
.DS_Store
